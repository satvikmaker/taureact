# ── Dev Server ──────────────────────────────────────────────────
PORT=5173                              # Vite dev server port

# ── Feature flags ──────────────────────────────────────────────
DEBUG_PROD=false                       # Open DevTools in production (read by Rust, not Vite)
VITE_ENABLE_OFFLINE_INDICATOR=false    # Show offline banner (VITE_ prefix: available to renderer)

# ── Code Signing (CI only) ─────────────────────────────────────
# CSC_LINK=                            # Code signing certificate path
# CSC_KEY_PASSWORD=                    # Certificate password

# ── macOS Notarization (CI only) ───────────────────────────────
# APPLE_ID=                            # macOS notarization Apple ID
# APPLE_ID_PASS=                       # App-specific password
# APPLE_TEAM_ID=                       # Apple Developer Team ID

# ── GitHub Releases (CI only) ──────────────────────────────────
# GH_TOKEN=                            # GitHub token for releases

# ── Tauri (set automatically) ──────────────────────────────────
# TAURI_SIGNING_PRIVATE_KEY=           # Updater signing key
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=  # Signing key password
